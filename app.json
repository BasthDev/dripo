{
  "expo": {
    "name": "Dripo",
    "slug": "Dripo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/adaptiveIcon.png",
    "scheme": "dripo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f8ede0",
        "foregroundImage": "./assets/images/dripo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.basth.Dripo",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withBluetoothPermissions.js",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/dripo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f8ede0",
          "dark": {
            "backgroundColor": "#f8ede0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
